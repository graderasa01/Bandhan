// BandhanTak — real schema, per DECISIONS.md D-30 (Postgres + Prisma + pgvector)
// and docs/bandhantak/modules/M02_auth_roles, M03_user_profile_builder/M03B,
// M04_verification_trust, and 08_architecture_and_experience_plan.md §9.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ============================================================
// M02 — Auth & Roles
// ============================================================

enum Role {
  USER
  PARTNER
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INCOMPLETE
  SUSPENDED
  BLOCKED
  DELETED
}

/// 2026-08-05, Devesh: voice profile-fill is a parent-for-child accessibility
/// tool by default (older parents filling a son/daughter's profile by
/// speaking) — not a general convenience feature for someone filling their
/// own. Filling for self stays keyboard-only unless an admin grants an
/// exception, which keeps the (paid, Sarvam-billed) voice path scoped to the
/// audience it was actually built for instead of every self-registering user
/// defaulting into it.
enum VoiceSelfFillStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String     @id @default(uuid())
  fullName         String
  mobile           String?    @unique
  email            String?    @unique
  /// Nullable since Google Sign-In: an account created through Google has no
  /// password at all, and storing a random unusable hash instead would make
  /// "can this account log in with a password?" unanswerable without trying.
  /// `POST /api/auth/login` treats null as "not a password account" and
  /// returns the same generic INVALID_CREDENTIALS as a wrong password, so the
  /// distinction never leaks to an attacker probing for Google accounts.
  passwordHash     String?
  /// Google's `sub` claim — stable for the life of the Google account and, per
  /// Google's own guidance, the only field safe to key on (email can change
  /// hands). Unique so two BandhanTak accounts can never bind to one Google
  /// identity.
  googleId         String?    @unique
  /// Google's profile picture URL. Shown only back to the user themselves —
  /// it is not, and must not become, a profile photo: those are moderated,
  /// consent-gated and owned by `ProfilePhoto`.
  avatarUrl        String?
  role             Role       @default(USER)
  status           UserStatus @default(INCOMPLETE)
  mobileVerifiedAt DateTime?
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  /// Self-fill voice access — see VoiceSelfFillStatus. Filling *for a child*
  /// needs none of this; it's checked only when fillingFor === "self".
  voiceSelfFillStatus     VoiceSelfFillStatus @default(NOT_REQUESTED)
  /// The user's own stated reason ("likhne mein dikkat hai" etc.) — mandatory
  /// to submit a request, same "no override without a reason" rule as
  /// UserEntitlementOverride.
  voiceSelfFillReason     String?
  voiceSelfFillReviewedAt DateTime?
  voiceSelfFillReviewedBy String?
  voiceSelfFillReviewNote String?

  /// Quick-unlock PIN — household privacy, NOT an authentication boundary.
  /// The session cookie is still what says "this is you"; the PIN only says
  /// "this is you *right now*, and not the cousin who just borrowed the
  /// phone". Indian matrimony users share handsets with family, and the
  /// chats/shortlists sitting behind a live session are exactly what they
  /// don't want a relative thumbing through. That framing is why "Forgot
  /// PIN?" simply logs out (see app/api/auth/pin) instead of running an
  /// account-recovery flow: losing the PIN costs a re-login, nothing more.
  ///
  /// Hashed with the same bcrypt helper as `passwordHash` (lib/auth/password)
  /// — a 4-digit space is tiny, so the only thing standing between a leaked
  /// column and 10,000 guesses is the work factor.
  pinHash           String?
  pinSetAt          DateTime?
  /// Reset on every successful verify. At `PIN_MAX_ATTEMPTS` the row is
  /// locked via `pinLockedUntil` rather than the account being touched —
  /// a fumbled PIN must never escalate into a blocked account.
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  sessions          AuthSession[]
  pushSubscriptions PushSubscription[]
  profile       Profile?
  swipeActions  SwipeAction[]
  dailyReels    DailyReel[]
  sentInterests Interest[]      @relation("InterestFrom")
  gotInterests  Interest[]      @relation("InterestTo")
  matchesAsA    Match[]         @relation("MatchUserA")
  matchesAsB    Match[]         @relation("MatchUserB")
  shortlists    Shortlist[]
  contactShares ContactShare[]
  aiInteractions AiInteraction[]
  sentMessages  Message[]
  partner         Partner?
  partnerReferral PartnerReferral?
  partnerOutreach PartnerOutreachMessage[]
  partnerInvite   PartnerInvite?
  shareLinksCreated ShareLink[]
  familyMembers     FamilyMember[]

  // M16 — engagement layer
  mediaAssets           MediaAsset[]
  voiceNotesSent        VoiceNote[]               @relation("VoiceNoteFrom")
  voiceNotesReceived    VoiceNote[]               @relation("VoiceNoteTo")
  notices               Notice[]
  rewardGrants          RewardGrant[]
  entitlementOverrides  UserEntitlementOverride[]
  celebrations          CelebrationLog[]
  questProgress         QuestProgress[]
  blocksMade            UserBlock[]               @relation("BlockFrom")
  blocksReceived        UserBlock[]               @relation("BlockTo")
  reportsMade           ContentReport[]           @relation("ReportFrom")
  reportsAgainst        ContentReport[]           @relation("ReportTo")
  subscriptions         Subscription[]
  payments              Payment[]
  matchmakerRequests    MatchmakerRequest[]
  pollVotes             PollVote[]
  questionsAsked        ProfileQuestion[]         @relation("ProfileQuestionFrom")
  questionsReceived     ProfileQuestion[]         @relation("ProfileQuestionTo")

  // Phase F — Serious Circle
  circleEntries         CircleEntry[]
  circleConnectionsAsA  CircleConnection[]        @relation("CircleConnA")
  circleConnectionsAsB  CircleConnection[]        @relation("CircleConnB")
  seriousBadge          SeriousBadge?

  // Phase G — Grio action layer
  grioMemory            GrioMemory?
  grioMemoryEntries     GrioMemoryEntry[]
  familyExpectations    FamilyExpectationAnswer[]
  rishtaJourneys        RishtaJourney[]

  @@map("users")
}

/// How far one rishta has actually come.
///
/// The first four are **facts** — an interest row exists, a match row exists,
/// messages exist. Everything from UNDERSTANDING onward is a **judgement** that
/// only the person living it can make: nothing in a database distinguishes
/// "chatting politely" from "seriously considering each other". So the derivation
/// stops at TALKING and the rest is confirmed by the user, one tap at a time.
///
/// That split is the whole design. A CRM that made people maintain ten stages by
/// hand would be abandoned in a week; one that *guessed* "seriously considering"
/// from message volume would be wrong in the direction that matters most.
enum RishtaStage {
  /// Seen in the reel or shortlisted. No one has reached out.
  DISCOVERED
  /// An interest has gone one way.
  INTERESTED
  /// Both said yes. Chat is open, nobody has spoken.
  MUTUAL_MATCH
  /// Messages are going back and forth.
  TALKING
  /// Confirmed by the user: this is being taken seriously.
  UNDERSTANDING
  /// Family knows and is involved.
  FAMILY_INVOLVED
  MEETING_PLANNED
  MET
  /// A decision is being made — either way.
  DECISION
  /// Ended. `closedReason` says how, in the user's own words.
  CLOSED
}

/// One person's view of one rishta.
///
/// ## Why this is per-user and not per-pair
///
/// Rahul marking "family involved" says nothing about whether Priya's family
/// knows. A shared row would mean one person's tap silently rewrites the other's
/// record of their own relationship — and worse, would leak: Priya could infer
/// Rahul's private stage from her own screen. Two rows, two truths, no
/// inference between them.
///
/// ## Nothing here is required for the app to work
///
/// A user who never confirms a stage still has a journey — it is simply the
/// derived one, computed on read from rows that already exist. This table stores
/// only what could not be derived, which is why it is sparse by design and why
/// a missing row is a normal state rather than a bug.
model RishtaJourney {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The other person. Not a `Profile` id — a journey survives a profile going
  /// hidden, and "wo profile ab nahi dikh rahi" is itself worth being able to say.
  otherUserId String

  /// The furthest stage the user has *confirmed*. Null while the derived stage
  /// is the whole truth. Never written by derivation — see `deriveStage`.
  confirmedStage   RishtaStage?
  confirmedStageAt DateTime?
  /// Free text, the user's own words. Only meaningful with CLOSED.
  closedReason     String?

  topics      RishtaTopic[]
  meetings    RishtaMeeting[]
  reflections RishtaReflection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, otherUserId])
  @@index([userId])
  @@map("rishta_journeys")
}

/// Something worth talking about, and whether it has been talked about.
///
/// Seeded from the Compatibility Lab's own dimensions — a `DISCUSS` row there is
/// an unresolved topic here — so the two never disagree about what matters.
/// `label` is denormalised rather than looked up on read because a topic the
/// user typed themselves has no catalog key at all.
model RishtaTopic {
  id        String        @id @default(uuid())
  journeyId String
  journey   RishtaJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  /// Catalog question key when this came from the compatibility comparison;
  /// null for a topic the user added in their own words.
  questionKey String?
  label       String
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  /// What the user concluded, if they said. Their words, never a model's.
  outcome     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([journeyId, label])
  @@index([journeyId, resolved])
  @@map("rishta_topics")
}

/// A meeting, planned or past.
///
/// `happenedAt` rather than a status enum: a meeting that has happened has a
/// date it happened on, and one that has not is simply null. A separate status
/// column would let the two disagree.
model RishtaMeeting {
  id        String        @id @default(uuid())
  journeyId String
  journey   RishtaJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  scheduledFor DateTime?
  happenedAt   DateTime?
  /// "Ghar par", "Cafe", "Video call" — free text, the user's words.
  place        String?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
  @@map("rishta_meetings")
}

/// The user's own note to themselves about this rishta.
///
/// Never shown to the other person, never to family, and never written by a
/// model — `SAVE_REFLECTION` proposes a card, the user's words are what get
/// stored. It exists so "20 din baad" the app can answer honestly instead of
/// reconstructing a feeling from message timestamps.
model RishtaReflection {
  id        String        @id @default(uuid())
  journeyId String
  journey   RishtaJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())

  @@index([journeyId, createdAt])
  @@map("rishta_reflections")
}

/// What Grio carries between conversations — Phase G, doc 11 §3.5.
///
/// One row per user holding a short list of plain-text facts, capped at
/// `GRIO_MEMORY_MAX_FACTS` in `lib/contracts/grio.ts`. Stored as a JSON array
/// rather than a row-per-fact table because the whole value is read and
/// rewritten together on every edit, is bounded to single digits by design,
/// and is never queried by content — a child table would buy indexing nobody
/// needs and cost a join on every chat turn.
///
/// The invariant this model cannot enforce but the service can (and does):
/// **only what the user said about themselves.** Never an inference the model
/// drew, and never a fact about another person — the same discipline
/// `bioWriter` and `deepProfileAnalysis` hold, applied to storage.
model GrioMemory {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// string[] — each entry <= GRIO_MEMORY_MAX_FACT_LENGTH chars.
  ///
  /// Superseded by `GrioMemoryEntry` and kept only as the migration's source of
  /// truth for rows written before it existed. Nothing reads this column any
  /// more; `lib/services/grio/memory.ts` reads the typed table. Dropping it is
  /// a separate, later change — a column that still holds the only copy of some
  /// users' data is not one to delete in the same release that stops writing it.
  facts     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("grio_memories")
}

/// What kind of thing the user asked Grio to remember.
///
/// Flat strings were enough while memory was a handful of notes and stopped
/// being enough the moment two of them could disagree. "Bangalore preferred"
/// and "Mumbai bhi theek hai" are not two facts — they are one preference that
/// changed, and a store that cannot say so hands the model both and lets it
/// pick. The kind is what makes that resolvable: a PREFERENCE can be replaced,
/// a FACT usually cannot, and a TEMPORARY_CONTEXT expires whether or not
/// anybody comes back to tidy it.
enum GrioMemoryKind {
  /// "Main TCS me kaam karta hoon" — a stable statement about the world.
  FACT
  /// "Bangalore preferred" — a leaning, and the kind most likely to be revised.
  PREFERENCE
  /// "Smoking bilkul nahi" — a line the user does not want crossed.
  BOUNDARY
  /// "Ek saal me shaadi" — something they are working toward.
  GOAL
  /// "Priya se relocation discuss karna hai" — about one rishta, not the user.
  RELATIONSHIP_NOTE
  /// "Agle mahine Mumbai me hoon" — true now, misleading later. Needs expiresAt.
  TEMPORARY_CONTEXT
}

/// One thing Grio remembers, with everything needed to know how much it counts.
///
/// ## Why a table and not a richer JSON blob
///
/// Every field below is queried or ordered on: active entries filter on
/// `replacedAt`/`expiresAt`, the plan cap counts rows, and supersession is a
/// relation. Keeping that in a JSON array would mean reading and rewriting a
/// user's whole memory to expire one line, and would make "show me what this
/// replaced" a client-side scan.
///
/// ## Supersession is explicit, never inferred
///
/// `supersedesId` is set because somebody said "this replaces that" — the user
/// tapping Update in the panel, or confirming a proposal. Nothing here guesses
/// that two entries conflict. String similarity would occasionally be right and
/// would occasionally delete a real memory the user never asked to lose, and
/// the second failure is not recoverable from the UI.
///
/// The superseded row is kept and marked (`replacedAt`) rather than deleted, so
/// "what did I used to think?" stays answerable. Only unreplaced, unexpired
/// rows reach the model.
model GrioMemoryEntry {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  kind      GrioMemoryKind @default(FACT)

  /// How this came to be remembered. `USER_ENTERED` for the panel and for the
  /// `remember` action (the model proposes the words, the user's request is what
  /// saves them). An `AI_INFERRED` row is possible but must never be written
  /// without confirmation — see `confirmed`.
  source    SignalSource   @default(USER_ENTERED)
  /// False only for something a model proposed that nobody has agreed to yet.
  /// An unconfirmed entry is shown with its badge and never spoken as fact.
  confirmed Boolean        @default(true)
  /// 0..100 when the source carries one. Null for anything the user typed —
  /// a person stating their own preference has no confidence score.
  confidence Int?

  /// Null for permanent memory. Required in spirit for TEMPORARY_CONTEXT, which
  /// is the whole reason the column exists.
  expiresAt DateTime?
  /// Set on the OLD row when a newer one replaces it.
  replacedAt DateTime?

  /// The entry this one replaces. One-to-one in both directions: an entry
  /// replaces at most one thing and is replaced by at most one thing, which
  /// makes the history a chain rather than a graph nobody can render.
  supersedesId String?          @unique
  supersedes   GrioMemoryEntry? @relation("GrioMemorySupersede", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy GrioMemoryEntry? @relation("GrioMemorySupersede")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The read every turn makes: this user's live memory, newest first.
  @@index([userId, replacedAt])
  @@map("grio_memory_entries")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  @@index([userId])
  @@map("auth_sessions")
}

/// One browser (or installed PWA) that has agreed to receive push.
///
/// Keyed by `endpoint` because that is what the push service itself considers
/// the identity of a subscription — the same user on the same device can hold
/// several (Chrome and the installed PWA are different endpoints), and a
/// re-subscription after a browser rotates its keys arrives as a *new*
/// endpoint, so upserting on it is what keeps this table from growing a stale
/// row per re-grant.
///
/// `p256dh`/`auth` are the UA's own public key and shared secret. They are not
/// credentials for anything in this app — losing them lets someone send this
/// browser a notification, not read one — but they are per-device identifiers,
/// so the row dies with the user (onDelete: Cascade) and with the first
/// 404/410 the push service returns.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  /// Bumped on every successful send — the only signal that a browser is still
  /// really there, since push services never say "still alive", only "gone".
  lastSentAt DateTime?

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================
// M03B — Profile core + sub-tables
// ============================================================

enum ProfileStatus {
  DRAFT
  INCOMPLETE
  READY_FOR_REVIEW
  SUBMITTED
  VERIFIED
  REJECTED
  BLOCKED
}

model Profile {
  id      String  @id @default(uuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileStatus ProfileStatus @default(DRAFT)
  displayName   String?
  // "Ladka" / "Ladki" — the app's own Hinglish option strings (lib/profile/fields.ts
  // is the source of truth for allowed values), deliberately not a Postgres enum so
  // the catalog never has to stay in sync with a migration.
  gender          String?
  dateOfBirth     DateTime? @db.Date
  maritalStatus   String?
  heightCm        Int?
  currentCity     String?
  currentState    String?
  currentCountry  String?   @default("India")
  nativePlace     String?
  bioText         String?

  profileCompletionScore Int      @default(0)
  /// % of every non-sensitive catalog field answered (required + optional,
  /// excludes caste/religion/income/manglik/gotra/birth-details and photos —
  /// see lib/profile/stages.ts fullProfileFields). Distinct from
  /// profileCompletionScore (required-fields-only, gates "profile live" /
  /// partner visibility) — this one gates Serious Circle, where a match
  /// deserves the whole profile, not just the minimum to go live.
  fullProfileCompletionScore Int  @default(0)
  trustScore             Int?
  trustScoreLabel        String? // UNKNOWN | LOW | MODERATE | GOOD | STRONG — M04A §3.1
  isVisible              Boolean  @default(false)

  /// C7's master toggle — "Meri Soch Board kisi ko na dikhe". Separate from
  /// `isVisible` on purpose: turning this off hides only the poll-answer
  /// board, not the whole profile. Defaults true (not opt-in) because the
  /// anti-dark-pattern rule (D-61) is disclosure at vote time, not a hidden
  /// default — `PollCard` tells the user plainly before they answer.
  sochBoardVisible Boolean @default(true)

  /// Opt-in (default false, unlike sochBoardVisible above) — a Deep Profile
  /// dimension score is an AI character read, not a poll answer, and nobody
  /// consented to it reaching a match when they first ran "Analyze My
  /// Profile" (that flow only ever promised a self-view report). Shown to a
  /// matched (L3) Premium viewer only once this is explicitly turned on —
  /// see deepProfileService.ts's getSharedDeepProfileView.
  deepProfileShareEnabled Boolean @default(false)

  /// Browse without your name appearing in anyone's "Viewed You" (Premium —
  /// `incognitoBrowse`). Symmetric by design: while this is on, the user's own
  /// viewer identities are hidden from them too, so it buys privacy rather
  /// than one-way advantage. See `canSeeViewerIdentity` in entitlements.ts.
  ///
  /// Only new swipes are affected — `SwipeAction.incognito` is stamped at
  /// write time, so turning this off never uncovers past browsing and turning
  /// it on never hides visits already attributed.
  incognitoEnabled Boolean @default(false)

  /// D-11's `boost` capability, as a single timestamp rather than a boolean —
  /// see lib/services/boost/boostService.ts. Two different things write this
  /// same field: an active STANDARD/PREMIUM subscription sets it to the
  /// subscription's `currentPeriodEnd` on every capture, and a spent
  /// RewardGrant(BOOST) credit sets it to now+24h. Whichever is later wins,
  /// because both are just answering the one question `pipeline.ts` asks:
  /// "is this profile boosted right now" — a plain `boolean` would need a
  /// second field for "until when" anyway, so this is the same information
  /// with no redundant flag to fall out of sync.
  boostActiveUntil DateTime?

  /// Who is actually answering — the interview has always asked "kis ke liye
  /// bhar rahe hain" (self / beta / beti) but only ever kept it in the client
  /// draft, so the server could not tell a candidate's own words from their
  /// parent's. That distinction matters for the subjective Marriage
  /// Intelligence answers: "mera beta joint family prefer karta hai" is a
  /// second-hand report, not the beta saying it. Per-field overrides live on
  /// `ProfileFieldProvenance` / `ProfileSignalAnswer`; this is the default.
  respondentType RespondentType @default(SELF)

  /// Phase F — the user's own declared answer to "shaadi kab tak". Null means
  /// never declared, which is a hard Serious Circle gate: the app will not
  /// guess this from age or activity, because guessing it wrong is exactly the
  /// mistake that makes a matrimony product feel like it is pushing people.
  marriageTimeline MarriageTimeline?

  submittedAt DateTime?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  basicDetails       ProfileBasicDetails?
  education          ProfileEducation?
  profession         ProfileProfession?
  family             ProfileFamily?
  lifestyle          ProfileLifestyle?
  partnerPreferences ProfilePartnerPreferences?
  photos             ProfilePhoto[]
  embedding          ProfileEmbedding?
  dimensionScores    ProfileDimensionScore[]
  signalAnswers      ProfileSignalAnswer[]
  fieldProvenance    ProfileFieldProvenance[]

  swipedBy       SwipeAction[]
  reelAppearances DailyReelProfile[]
  shortlistedBy   Shortlist[]
  shareLinks      ShareLink[]
  familyNotes     FamilyNote[]

  @@index([profileStatus])
  @@index([isVisible])
  @@map("profiles")
}

model ProfileBasicDetails {
  profileId     String  @id
  profile       Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  firstName     String?
  lastName      String?
  motherTongue  String?
  religion      String?
  community     String?
  caste         String?
  gotra         String?
  manglikStatus String?
  birthTime     String?
  birthPlace    String?

  @@map("profile_basic_details")
}

model ProfileEducation {
  profileId         String  @id
  profile           Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  highestEducation  String?
  degreeName        String?
  collegeName       String?

  @@map("profile_education")
}

model ProfileProfession {
  profileId          String  @id
  profile            Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  professionCategory String?
  jobTitle           String?
  companyName        String?
  annualIncomeRange  String?
  workCity           String?

  @@map("profile_profession")
}

model ProfileFamily {
  profileId               String  @id
  profile                 Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  familyType               String?
  familyBackgroundSummary  String?
  fatherOccupation         String?
  motherOccupation         String?
  siblingsCount            String? // bucketed strings per catalog: "Koi nahi","1","2","3","3 se zyada"
  siblingsMarriedStatus    String?
  familyValues             String?

  @@map("profile_family")
}

model ProfileLifestyle {
  profileId        String   @id
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  diet             String?
  smoking          String?
  drinking         String?
  hobbies          String[]
  languagesKnown   String[]
  relocateWilling  String?

  // Mindset / vibe — 3 situational questions asked once, right after Stage 1
  // goes live (see lib/profile/mindset.ts). Deliberately not AI-extracted:
  // these are tap-to-answer choices, so the interview never spends a Sonnet
  // call on them. `buildVibeLine()` turns whichever of the three are answered
  // into a short, deterministic one-liner — no AI cost there either (D-32:
  // this is understanding-free templating, not model reasoning).
  weekendVibe      String?
  bigDecisionStyle String?
  socialEnergy     String?

  @@map("profile_lifestyle")
}

model ProfilePartnerPreferences {
  profileId               String   @id
  profile                 Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // Defaults to the opposite of profile.gender at creation — see fieldMapping.ts.
  lookingForGender         String?
  minAge                   Int?
  maxAge                   Int?
  preferredCities          String[]
  educationPreference      String?
  incomePreference         String?
  maritalStatusPreference  String?
  manglikPreference        String?
  /// Explicit, user-declared "what I want", scored against a candidate's own
  /// religion/caste the same way educationPreference already is — never an
  /// automatic signal derived from the viewer's own religion/caste (that stays
  /// out of every embedding, M17 §L1). "Koi farak nahi" is a first-class,
  /// zero-effect answer, not a missing one.
  religionPreference       String?
  castePreference          String?
  partnerWorkExpectation   String?
  dealBreakers             String[]

  @@map("profile_partner_preferences")
}

// ============================================================
// Marriage Intelligence — the second data layer
// (lib/profile/intelligenceQuestions.ts is the question catalog)
// ============================================================

/// Where a fact came from. `AI_INFERRED` is deliberately its own value and not
/// folded into `BIODATA_EXTRACTED`: extracted means the model read it in the
/// document, inferred means the model guessed it from something else, and only
/// the first is quotable back to the user. An `AI_INFERRED` value that has not
/// been confirmed is never treated as a fact — see intelligenceService.ts.
enum SignalSource {
  USER_ENTERED
  USER_CONFIRMED_AI
  BIODATA_EXTRACTED
  AI_INFERRED
  GOOGLE_IMPORTED
  VERIFIED_DOCUMENT
}

enum RespondentType {
  SELF
  PARENT
  GUARDIAN
  FAMILY_MEMBER
}

/// Assigned by the server from the question catalog on every write, never from
/// the request body — a client cannot talk a private answer onto a profile.
/// MATCH_PRIVATE means "matching may use it, nobody may read it": money style,
/// children timeline, conflict style, parent-care responsibility.
enum SignalVisibility {
  PROFILE_VISIBLE
  MATCH_PRIVATE
  PRIVATE
}

/// One answered Marriage Intelligence question.
///
/// Kept out of `ProfileLifestyle` (and the rest of the M03B tables) on purpose:
/// forty more nullable columns would make the profile builder large again and
/// would put product questions behind a migration every time one is reworded.
/// Question *definitions* live in code (`lib/profile/intelligenceQuestions.ts`);
/// this table stores only what a person answered.
model ProfileSignalAnswer {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// A key from `INTELLIGENCE_KEYS`. Validated on write — an unknown key is
  /// rejected rather than stored as a row nothing will ever read.
  key String

  /// The chosen option string, or an array of them for a multi-select
  /// (deal breakers). Json so both share one row shape.
  answerJson Json

  source         SignalSource     @default(USER_ENTERED)
  respondentType RespondentType   @default(SELF)
  /// False for a subjective answer a parent gave on the candidate's behalf, or
  /// an unconfirmed AI inference. Such an answer is still stored and still
  /// shown ("confirm hona baaki hai") but carries less evidence in ranking.
  confirmed      Boolean          @default(true)
  visibility     SignalVisibility @default(MATCH_PRIVATE)
  /// Bumped when a question's option list changes in a way that invalidates
  /// stored answers, so a migration can find the rows to re-ask.
  schemaVersion  Int              @default(1)

  answeredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([profileId, key])
  @@index([profileId])
  @@map("profile_signal_answers")
}

/// Per-field provenance for the *existing* profile catalog — "Rahul works at
/// TCS" came from where?
///
/// `lib/profile/profileState.tsx` has always tracked this client-side (source,
/// confidence, the user's own words, confirmed) and its own docstring called it
/// an interview-UI affordance that never reached the server. That was fine while
/// nothing downstream cared; it is not fine now that Marriage Intelligence and
/// Deep Profile both need to know whether a value is something the user said or
/// something a model guessed.
model ProfileFieldProvenance {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// A `PROFILE_FIELDS` key (lib/profile/fields.ts).
  fieldKey String

  source SignalSource
  /// 0..100. Null for a hand-typed value — confidence is a model's word, and
  /// storing 100 for a human would make the two indistinguishable later.
  confidence     Int?
  confirmed      Boolean        @default(false)
  confirmedAt    DateTime?
  /// The user's own words this came from, or the biodata heading it sat under.
  sourceContext  String?
  respondentType RespondentType @default(SELF)

  updatedAt DateTime @updatedAt

  @@unique([profileId, fieldKey])
  @@index([profileId])
  @@map("profile_field_provenance")
}

model ProfilePhoto {
  id                 String    @id @default(uuid())
  profileId          String
  profile            Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fileUrl            String
  storageKey         String
  isPrimary          Boolean   @default(false)
  verificationStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED
  uploadedAt         DateTime  @default(now())
  verifiedAt         DateTime?
  rejectedReason     String?
  deletedAt          DateTime?

  // Reel Slides (Phase 2) — the owner's own words on their own photo, not a
  // caption. Max 80 chars, enforced in the API, not here (Postgres varchar
  // limits produce a truncation error message no user-facing form wants to
  // surface). null = this photo carries no note.
  note      String?
  // 1..4 = this photo's position in the slide reel; null = not included.
  // Deliberately sparse rather than a join table — a profile has at most 6
  // photos total, so "which 4, in what order" fits on the row itself.
  slotOrder Int?
  // 0..100, vertical focal point for `object-cover` crops — null = center
  // (50). A portrait photo squeezed into the Reel's 4:3 frame otherwise
  // crops from dead-center regardless of where the face actually sits; the
  // owner sets this once, and every `object-cover` render (Reel card,
  // profile header, thumbnails) honours the same value.
  focalY Int?

  @@index([profileId])
  @@map("profile_photos")
}

// Singleton toggle, same "one row named default" pattern as
// PartnerCommissionConfig. When `photoVerificationRequired` is false, new
// photo uploads (and AI-enhanced re-uploads) are created/reset straight to
// APPROVED instead of PENDING — every existing `verificationStatus ===
// "APPROVED"` check downstream (Reel eligibility, verified badge, trust
// score, photo slides, blur derivative) already reads that one field, so
// this single switch changes all of them without touching their code.
model VerificationSettings {
  id                        String   @id
  photoVerificationRequired Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?

  @@map("verification_settings")
}

// Site-wide colour theme — admin-controlled, no redeploy needed (see
// lib/services/theme/siteThemeService.ts). Same singleton pattern as
// VerificationSettings. `KUNDAN`/`RAAT`/`KAAGAZ` are complete, contrast-
// audited palettes defined in app/globals.css ([data-pack="..."] blocks);
// `CUSTOM` layers the five customXxx hex overrides below on top of KUNDAN's
// full token set, so a free colour pick can only ever touch brand-identity
// colour (primary/accent/signal) — never the structural neutrals or
// semantic warn/danger/info tokens, which stay contrast-safe by
// construction. The customXxx fields are only read when pack == CUSTOM.
enum ThemePack {
  KUNDAN
  RAAT
  KAAGAZ
  CUSTOM
}

model SiteTheme {
  id   String    @id
  pack ThemePack @default(KUNDAN)

  customPrimary     String?
  customPrimaryText String?
  customAccent      String?
  customAccentText  String?
  customSignal      String?

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_theme")
}

// Schema-ready L1 vector recall (D-33) — not populated yet. See plan Context:
// needs an embeddings provider (Voyage AI) the user hasn't provisioned. At
// seed/dev scale L0+L2 alone are fast enough; this table just means turning
// L1 on later is additive, not a migration.
model ProfileEmbedding {
  profileId    String    @id
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  embedding    Unsupported("vector(1024)")?
  modelVersion String?
  computedAt   DateTime?

  @@map("profile_embeddings")
}

// D-11's `deepDimensions` — 05_ai_spec.md §15's 13 dimensions, exactly as
// named there. M17's deepProfileFit formula (§3.2) is what finally consumes
// these: for a viewer/candidate pair, average `100 - abs(diff)` over
// dimensions BOTH have a non-null score for; fewer than 3 in common → the
// pair gets no deep-fit signal at all (pipeline.ts redistributes L2's 0.25
// weight across the other live signals for that pair specifically).
//
// One row per (profile, dimension) rather than one JSON blob on Profile: a
// dimension gets recomputed independently as more signal becomes available,
// and `getEntitledDimensionKeys` needs to filter to a subset per plan without
// parsing JSON to do it.
enum DeepDimensionKey {
  FAMILY_ORIENTATION
  CAREER_FOCUS
  COMMUNICATION_CLARITY
  EMOTIONAL_MATURITY
  PRACTICAL_DECISION_STYLE
  ADAPTABILITY
  FINANCIAL_DISCIPLINE
  TRADITION_MODERN_BALANCE
  RELATIONSHIP_READINESS
  CONFLICT_HANDLING
  LONG_TERM_STABILITY
  LIFESTYLE_ALIGNMENT
  PARTNER_SUPPORT_EXPECTATION
}

/// §15.1's score contract, adapted: `based_on_answer_count`/`missing_answer_count`
/// assume a dedicated deep-question interview (M06) that doesn't exist yet.
/// This MVP derives scores from the profile's existing fields instead (bio,
/// lifestyle, family, mindset, profession) — see deepProfileService.ts. When
/// M06 ships a real question flow, those two counts can be added without
/// touching this table's shape; `explanationText` already carries the "why"
/// in the meantime.
model ProfileDimensionScore {
  id              String           @id @default(uuid())
  profileId       String
  profile         Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dimensionKey    DeepDimensionKey
  /// Null when scoreLabel is UNKNOWN — §15.3's rule, enforced in code
  /// (confidenceScore < 0.6 forces both to null/UNKNOWN regardless of what
  /// the model proposed; D-32, AI proposes, code decides what's shown).
  scoreValue      Int?
  scoreLabel      String // LOW | MODERATE | GOOD | STRONG | UNKNOWN
  confidenceScore Float // 0..1, per §15.1's example shape
  explanationText String?
  computedAt      DateTime         @default(now())

  @@unique([profileId, dimensionKey])
  @@index([profileId])
  @@map("profile_dimension_scores")
}

// ============================================================
// M07 / 08_architecture — Rishta Reel matching
// ============================================================

enum SwipeDirection {
  LEFT // abhi nahi
  RIGHT // interest
  UP // AI se poocho
  DOWN // family shortlist
}

model SwipeAction {
  id              String         @id @default(uuid())
  actorUserId     String
  actor           User           @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  targetProfileId String
  targetProfile   Profile        @relation(fields: [targetProfileId], references: [id], onDelete: Cascade)
  dailyReelId     String?
  dailyReel       DailyReel?     @relation(fields: [dailyReelId], references: [id], onDelete: SetNull)
  direction       SwipeDirection
  decisionMs      Int?
  wasButton       Boolean        @default(false) // a11y tracking — §4.5
  /// Whether the actor was browsing incognito when this swipe happened, so the
  /// target's "Viewed You" panel must not attribute it (`admirerService`).
  ///
  /// Stamped on the row at write time rather than read from the actor's
  /// current setting, and that is the whole promise: filtering by today's
  /// setting would mean switching incognito off retroactively reveals every
  /// visit made while it was on. The swipe still exists — it is what stops the
  /// reel re-showing the card — only its attribution is hidden.
  incognito       Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([actorUserId])
  @@index([targetProfileId])
  @@map("swipe_actions")
}

model DailyReel {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelDate    DateTime  @db.Date
  dailyLimit  Int       @default(5)
  generatedAt DateTime  @default(now())
  openedAt    DateTime?

  candidates DailyReelProfile[]
  swipes     SwipeAction[]

  @@unique([userId, reelDate])
  @@map("daily_reels")
}

// One row per candidate in a user's reel for a day — the real, queryable
// version of the doc's `computed_scores_json` / `ai_explanations_json`.
model DailyReelProfile {
  id                   String    @id @default(uuid())
  dailyReelId          String
  dailyReel            DailyReel @relation(fields: [dailyReelId], references: [id], onDelete: Cascade)
  profileId            String
  profile              Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rank                 Int
  preferenceScore      Float
  trustScoreFactor     Float
  recentActivityScore  Float
  /// Null when the pair had fewer than 3 dimensions in common (M17 §3.2) —
  /// no signal, distinct from a real low-fit score.
  deepProfileFit       Float?
  finalScore           Float
  aiReasonText         String?
  aiConcernText        String?
  explainedAt          DateTime?

  @@unique([dailyReelId, profileId])
  @@index([profileId])
  @@map("daily_reel_profiles")
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  /// Sender took it back, within `INTEREST_WITHDRAW_WINDOW_HOURS` of sending
  /// and only while still PENDING. The row survives rather than being deleted:
  /// it is what keeps the monthly `interestsPerMonth` count honest (a withdrawn
  /// interest was still spent) and what lets a re-send be recognised as one.
  WITHDRAWN
}

model Interest {
  id         String         @id @default(uuid())
  fromUserId String
  fromUser   User           @relation("InterestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User           @relation("InterestTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status     InterestStatus @default(PENDING)
  message    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@map("interests")
}

model Match {
  id        String   @id @default(uuid())
  userAId   String
  userA     User     @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages      Message[]
  contactShares ContactShare[]
  quizBattles   QuizBattle[]

  @@unique([userAId, userBId])
  @@map("matches")
}

// Chat is scoped to matched pairs — Match is the thread key, no separate
// Conversation model. readAt = "read by the recipient" (every message has
// exactly one recipient, the other side of the 1:1 match), so unread counts
// need no extra join table.
model Message {
  id        String    @id @default(uuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([matchId, createdAt])
  @@map("messages")
}

/// One row = one person agreeing to hand over their own mobile number inside a
/// match. Two rows on the same match is the unlock; a single row reveals
/// nothing to anyone.
///
/// Modelled as consent-per-person rather than a boolean on Match because that
/// is what it actually is — and because it makes the honest UI state ("aapne
/// haan kar di, unka jawab baaki hai") representable instead of guessed. M08's
/// safety rule is that the first contact happens inside the platform, so a
/// number is never revealed by matching alone.
model ContactShare {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([matchId, userId])
  @@index([matchId])
  @@map("contact_shares")
}

// Swipe-down target. Honest naming: there is no Family Circle account system
// yet (not a built module), so this is a personal shortlist, not a "sent to
// family" claim.
model Shortlist {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetProfileId String
  targetProfile   Profile  @relation(fields: [targetProfileId], references: [id], onDelete: Cascade)
  note            String?
  createdAt       DateTime @default(now())

  // Null = the owner added it themself. Set when a PARENT/SIBLING family
  // session added it — the retention hook ("Papa ne Priya ko shortlist ki")
  // reads this, and it's the one place a family action leaves a trace on the
  // owner's own data.
  addedByFamilyMemberId String?
  addedByFamilyMember   FamilyMember? @relation(fields: [addedByFamilyMemberId], references: [id], onDelete: SetNull)

  @@unique([userId, targetProfileId])
  @@map("shortlists")
}

enum ShareLinkKind {
  OWN_BIODATA
  RISHTA_CARD
  /// C7 — the owner's own Mindset Arena answers + optional voice clips.
  SOCH_BOARD
}

// Phase 3 — one link system, two uses. OWN_BIODATA is a self-export the owner
// hands out on their own terms (mobile/income opt-in, same choice as the print
// biodata). RISHTA_CARD is a matched candidate's L3 profile the viewer shares
// onward to family — mobile/income are hardcoded false at creation and
// re-checked at resolve time, never taken from the caller.
model ShareLink {
  id              String        @id @default(uuid())
  token           String        @unique
  kind            ShareLinkKind
  profileId       String
  profile         Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User          @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  includeMobile   Boolean       @default(false)
  includeIncome   Boolean       @default(false)
  expiresAt       DateTime
  revokedAt       DateTime?
  viewCount       Int           @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime      @default(now())

  @@index([profileId])
  @@index([createdByUserId])
  @@map("share_links")
}

// ============================================================
// M6 — Family Circle (D-03: family is core, not an afterthought)
//
// Deliberately its OWN auth world, not a User with role FAMILY. `getCurrentUser`
// and every `/user/*` · `/api/messages/*` · `/api/interests/*` route check for
// `SESSION_COOKIE`, which a family session never has — so "family can never
// reach chat" (D-03's one non-negotiable rule) holds structurally, by the two
// cookie systems never overlapping, not by a role check someone could forget
// to add to a new route later.
//
// There is also no password: FamilyMember.inviteToken *is* the credential.
// Whoever holds the invite link can tap the one join button and bind a
// device — nothing is typed, nothing to phish beyond the link itself. The
// containment for that trade-off is the permission table below (view-only,
// never chat, never send interest) plus a short bind window and instant
// owner-side revoke — see `familyService.ts` for the full reasoning.
// ============================================================

enum FamilyRelation {
  PARENT
  SIBLING
  GUARDIAN
}

enum FamilyMemberStatus {
  INVITED
  ACTIVE
  REVOKED
}

model FamilyMember {
  id              String             @id @default(uuid())
  ownerUserId     String
  owner           User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  displayName     String
  relation        FamilyRelation
  status          FamilyMemberStatus @default(INVITED)
  // The link's token. Bind-only for 48h from (re)issue — after that a stale
  // forwarded link can no longer seat a new device, though sessions already
  // bound keep working until revoked.
  inviteToken     String             @unique
  inviteExpiresAt DateTime
  boundAt         DateTime?
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())

  sessions      FamilySession[]
  shortlisted   Shortlist[]
  notes         FamilyNote[]
  expectations  FamilyExpectationAnswer[]

  @@unique([ownerUserId, displayName])
  @@index([ownerUserId])
  @@map("family_members")
}

/// What the family expects of the marriage — stored beside the candidate's own
/// answer, never on top of it.
///
/// ## Why this is a separate table and not a `respondentType` on the existing row
///
/// `ProfileSignalAnswer` is unique on `(profileId, key)`. That was right while
/// the only question was "what does this profile say", and it is exactly wrong
/// here: a parent answering `postMarriageLivingPlan` would *overwrite* their
/// child's answer, and the gap this whole feature exists to surface would be
/// destroyed in the act of recording it. One row per question cannot hold a
/// disagreement.
///
/// So family expectations live here, keyed by the member who gave them. Papa
/// and Mummy can disagree with each other as easily as either can disagree with
/// the candidate, and all three answers survive.
///
/// ## What it deliberately is not
///
/// Not a second question catalog. `questionKey` points at
/// `lib/profile/intelligenceQuestions.ts`, and only the subset in
/// `FAMILY_EXPECTATION_KEYS` may be written — so the family answers the same
/// question, from the same option list, which is what makes a comparison
/// meaningful rather than a translation exercise.
///
/// Not an input to matching. Nothing in the L2 pipeline reads this table. The
/// family's expectations shape a conversation the user has at home; they do not
/// shape who that user is shown. Wiring them into ranking would let a parent
/// silently filter their child's matches, which is a different product and not
/// one anybody asked for.
model FamilyExpectationAnswer {
  id             String       @id @default(uuid())
  /// Denormalised from `familyMember.ownerUserId` so the owner-side read — the
  /// only hot path — is one indexed query with no join.
  ownerUserId    String
  owner          User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  /// A key from the Marriage Intelligence catalog. Validated on write against
  /// `FAMILY_EXPECTATION_KEYS`; a row whose key later leaves the catalog is
  /// skipped on read rather than surfaced, same rule as `rowsToSignalMap`.
  questionKey String
  /// string | string[], matching the catalog question's own option list.
  answerJson  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One answer per person per question — a parent changing their mind updates
  /// their own row and never touches anybody else's.
  @@unique([familyMemberId, questionKey])
  @@index([ownerUserId])
  @@map("family_expectation_answers")
}

// One row per bound device — a parent opening the link from both a phone and
// a tablet is normal, not a seat-sharing exploit, so binding is allowed
// multiple times inside the invite's 48h window rather than once ever.
model FamilySession {
  id               String       @id @default(uuid())
  familyMemberId   String
  familyMember     FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  sessionTokenHash String       @unique
  userAgent        String?
  // Sliding 90-day window — refreshed on every successful check, the same
  // "still around" pattern AuthSession uses, so a family member who drops by
  // now and then never gets silently signed out, but months of no activity
  // do expire it.
  expiresAt        DateTime
  createdAt        DateTime     @default(now())
  lastUsedAt        DateTime     @default(now())
  revokedAt        DateTime?

  @@index([familyMemberId])
  @@map("family_sessions")
}

// PARENT-only in the UI (`familyService.ts`'s permission table) — siblings
// can shortlist but the plan never gave them a note field, and guardians are
// view-only entirely.
model FamilyNote {
  id              String       @id @default(uuid())
  familyMemberId  String
  familyMember    FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  targetProfileId String
  targetProfile   Profile      @relation(fields: [targetProfileId], references: [id], onDelete: Cascade)
  body            String
  createdAt       DateTime     @default(now())

  @@index([targetProfileId])
  @@map("family_notes")
}

// ============================================================
// M10 — Partner onboarding / M11 — Referral engine
// Commission (M13) tables live further below, once Payment/Subscription
// (M09) are defined — a commission only exists against a CAPTURED payment
// (D-14). Payout (M14) tables are still deliberately absent: commissions are
// tracked (PENDING/APPROVED/PAID/REVERSED) but there is no payout execution
// or bank-verification flow yet, so those tables would have nothing to hold.
// ============================================================

enum PartnerType {
  PANDIT
  MARRIAGE_BUREAU
  RISHTA_CONSULTANT
  COMMUNITY_COORDINATOR
  FAMILY_REFERENCE_PARTNER
  WEDDING_VENDOR
  OTHER
}

enum PartnerStatus {
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  INACTIVE
  REJECTED
  SUSPENDED
}

enum ReferralCodeType {
  AUTO
  VANITY
}

enum AttributionMethod {
  CODE
  LINK
  QR
  ADMIN
}

// ============================================================
// M09 — Subscription Plans (pricing only — no payment/checkout yet)
// ============================================================

// Name and feature ladder (D-11) are locked and live in lib/constants/plans.ts,
// not here — only the price is meant to move, and only admin moves it.
/// The plan catalog — **this table is the source of truth now**, not a price
/// list bolted onto a code-defined ladder.
///
/// ## The reversal, written down so nobody re-derives it as a bug
///
/// D-11's ladder lived in lib/constants/plans.ts precisely so it could *not*
/// be edited from an admin panel: plan names and every capability were settled
/// in code, and the file said so. `Plan.priceInPaise` and later
/// `Plan.reelPerDay` were the only cracks in it.
///
/// Devesh reversed that deliberately (2026-08-07), after the trade-off was put
/// to him: he wants to add a cheaper plan, and re-price what each tier
/// includes, without waiting on a deploy. So `code` is a plain string rather
/// than an enum (there is no fixed set any more), and `features` carries the
/// whole capability set.
///
/// What is *kept* from the old design: lib/constants/plans.ts still owns the
/// `PlanFeatureSet` shape, the per-key types, and the four built-in plans'
/// defaults — which seed this table and remain the fallback if it is empty or
/// unreachable. A capability an admin has never touched still reads exactly
/// what the ladder always said.
model Plan {
  id           String  @id @default(uuid())
  /// Uppercase slug. FREE/BASIC/STANDARD/PREMIUM are seeded; anything else is
  /// an admin's own plan. Referenced by string from Subscription, Payment and
  /// UserEntitlementOverride, so it is never renamed once live — a plan is
  /// deactivated, not renamed.
  code         String  @unique
  name         String
  priceInPaise Int
  isActive     Boolean @default(true)
  /// Whether it appears on the public pricing page. A private plan still works
  /// for anyone already on it and can still be granted by hand — that is how
  /// an offer-only or grandfathered tier exists without confusing new visitors.
  isPublic     Boolean @default(true)
  displayOrder Int
  /// Where this sits on the ladder. Drives "is this an upgrade", `higherOf()`
  /// and `nextPlanUp()` — the job `PLAN_ORDER`'s array index used to do.
  /// Distinct from `displayOrder`, which is only about column order on a page.
  rank         Int     @default(0)
  /// "per month", "hamesha", "3 mahine" — shown next to the price.
  durationLabel String @default("per month")

  /// The whole PlanFeatureSet (lib/constants/plans.ts) as JSON. Read through
  /// `getPlanCatalog()`, which merges it over the built-in defaults so a
  /// missing key can never turn into `undefined` at a gate.
  features Json?

  updatedAt DateTime @updatedAt
  updatedBy String?

  /// Superseded by `features.reelPerDay`. Kept as a column so the 2026-08-07
  /// migration could carry existing admin overrides into `features` without a
  /// data-loss window; new writes go to `features`.
  reelPerDay Int?

  @@map("plans")
}

// ============================================================
// M09 — Subscriptions & payments
//
// The gateway is behind a seam (lib/services/payments/gateway.ts): a
// DummyGateway runs while RAZORPAY_KEY_ID is unset, and both gateways drive
// the identical rows and the identical webhook path. So these tables describe
// what happened, never which provider it happened through — the only
// provider-shaped columns are the two nullable external ids.
// ============================================================

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED /// user cancelled; still ACTIVE-equivalent until currentPeriodEnd
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

/// One row per user per subscription life. A renewal extends
/// `currentPeriodEnd` on the same row rather than creating a new one — the
/// subscription is the relationship, `Payment` is the event log.
model Subscription {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode         String
  status           SubscriptionStatus
  startedAt        DateTime           @default(now())
  /// Access lasts until this moment, even after a cancellation (D-10: monthly,
  /// and someone who paid for the month keeps the month).
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  /// Null on the dummy gateway. Populated once Razorpay is live.
  externalId       String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments Payment[]

  @@index([userId, status])
  @@map("subscriptions")
}

/// Every attempt, not just the successes — a FAILED row is how "payment nahi
/// hua" becomes answerable instead of invisible.
model Payment {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planCode       String
  amountPaise    Int
  /// D-13: ₹500 off Basic, first ever paid subscription only. Stored per
  /// payment so the discount is auditable rather than inferred from the total.
  discountPaise  Int           @default(0)
  status         PaymentStatus @default(CREATED)
  /// Gateway's order id. Unique so a replayed webhook cannot create a second row.
  externalOrderId   String?    @unique
  externalPaymentId String?    @unique
  /// True when this payment came from the dummy gateway — so a real ledger can
  /// exclude test money without guessing from the id format.
  isTest         Boolean       @default(false)
  failureReason  String?
  capturedAt     DateTime?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())

  commission PartnerCommission?

  @@index([userId, status])
  @@map("payments")
}

enum CommissionStatus {
  PENDING /// inside the 7-day refund window (D-14)
  APPROVED
  PAID
  REVERSED /// the payment behind it was refunded
}

/// Earned, never assigned: a tier is a pure function of how many referred
/// members actually paid (see lib/partner/tier.ts). Stored on a commission row
/// only as a frozen record of what was true when the money was earned.
enum PartnerTier {
  BRONZE
  SILVER
  GOLD
}

enum OutreachChannel {
  WHATSAPP
  EMAIL
}

/// MANUAL = the partner pressed send. AUTOMATED = the nudge job sent it on
/// their behalf. Kept apart so a partner can switch the automated half off
/// without losing the manual button.
enum OutreachTrigger {
  MANUAL
  AUTOMATED
}

enum OutreachStatus {
  QUEUED
  SENT
  FAILED
}

/// PENDING = created but nothing sent (the partner chose to share it
/// themselves). The rest are the invite's own lifecycle, not a message's.
enum InviteStatus {
  PENDING
  SENT
  FAILED
  OPENED
  JOINED
}

/// D-12 (percentage of what was paid) + D-80 (every renewal, lifetime).
///
/// One row per CAPTURED payment, and the unique paymentId is what makes that
/// literal: a webhook delivered twice cannot pay a partner twice.
model PartnerCommission {
  id          String           @id @default(uuid())
  partnerId   String
  partner     Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  paymentId   String           @unique
  payment     Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  userId      String
  amountPaise Int

  /// How this row's amount was arrived at, frozen at earn time. Both the
  /// config rate and the partner's tier move over time, so a payout queried
  /// months later has to be explainable without replaying history — "₹149,
  /// 12% of the ₹1,249 they paid, at Silver" is answerable; "₹149" is not.
  basePaise         Int         @default(0)
  percentBpsApplied Int         @default(0)
  tierAtEarning     PartnerTier @default(BRONZE)

  status      CommissionStatus @default(PENDING)
  approvedAt  DateTime?
  paidAt      DateTime?
  reversedAt  DateTime?
  createdAt   DateTime         @default(now())

  /// When this stops being refundable and becomes payable — capture time plus
  /// `PartnerCommissionConfig.maturityDays`. Stored rather than recomputed so
  /// changing the window later cannot retroactively claw back money a partner
  /// was already told was theirs, and so a partner can be shown a real unlock
  /// date instead of "kuch din me".
  ///
  /// Null on rows written before this existed; those fall back to
  /// createdAt + the configured window, exactly as they always did.
  maturesAt DateTime?

  /// Set when this commission is bundled into a withdrawal. Until then it is
  /// loose balance.
  withdrawalId String?
  withdrawal   PartnerWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@index([withdrawalId])
  @@map("partner_commissions")
}

/// How a partner wants to be paid.
///
/// This reverses the note above `Partner` ("payout-account intentionally not
/// collected — storing them with no payout flow and no encryption-at-rest
/// would be a liability rather than a feature"). Both halves of that objection
/// are answered now: there is a real payout flow (PartnerWithdrawal below), and
/// the account number is encrypted at rest with lib/security/secretBox.ts.
///
/// Only the last 4 digits are ever sent to a browser. The full number is
/// decrypted in exactly one place — the admin's audited reveal, at the moment
/// a payment is actually being made.
enum PayoutMethod {
  UPI
  BANK
}

model PartnerPayoutAccount {
  id        String  @id @default(uuid())
  partnerId String  @unique
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  method            PayoutMethod
  accountHolderName String

  /// UPI id, encrypted. Set only when `method` is UPI.
  upiCipher String?
  upiIv     String?
  upiTag    String?
  upiLast4  String?

  /// Bank account number, encrypted. Set only when `method` is BANK.
  accountCipher String?
  accountIv     String?
  accountTag    String?
  accountLast4  String?
  /// IFSC is not a secret — it identifies a branch, not an account — so it is
  /// stored plainly and shown to the partner so they can check their own entry.
  ifsc     String?
  bankName String?

  /// An admin has eyeballed the details against the partner's identity. A
  /// withdrawal cannot be paid until this is set — the one check standing
  /// between a typo and money going to a stranger.
  verifiedAt   DateTime?
  verifiedBy   String?
  rejectedNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partner_payout_accounts")
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

/// A partner asking for their matured balance.
///
/// Before this, a "payout" was an admin flipping one commission row to PAID —
/// no request, no batch, no reference number, and nothing the partner could
/// initiate. This is the request, and the `utr` is the thing that makes a
/// dispute answerable ("bhej diya" versus "kab, kaunse reference se").
///
/// The money movement itself is still a human at a bank (see
/// lib/services/payouts/providers) — this records the decision trail around it
/// so it can be automated later without changing anything a partner sees.
model PartnerWithdrawal {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  amountPaise Int
  status      WithdrawalStatus @default(REQUESTED)

  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  paidAt          DateTime?
  paidBy          String?
  /// Bank reference for the actual transfer. Required to mark PAID.
  utr             String?
  providerRef     String?
  rejectionReason String?

  commissions PartnerCommission[]

  @@index([partnerId, status])
  @@index([status, requestedAt])
  @@map("partner_withdrawals")
}

// D-12, revised 2026-08-06: commission is a PERCENTAGE of what the member
// actually paid, not a flat amount — bringing a Premium member is worth more
// work than bringing a Basic one, and a flat rate paid both the same.
//
// Still exactly one row, and still not keyed by plan: the percentage is
// uniform across every plan and every renewal. The only thing that moves it is
// the partner's own earned tier, which is a property of the partner rather
// than of the plan. That keeps what D-12 was actually protecting — no per-plan
// slab table nobody can hold in their head — while letting the rate scale with
// the value delivered.
model PartnerCommissionConfig {
  id String @id

  /// Basis points (1000 = 10.00%), so half-percent rates need no float.
  baseBps Int @default(1000)

  /// Added on top of baseBps once a partner has earned that tier. Bronze is
  /// the base rate itself, so it needs no bonus field.
  silverBonusBps Int @default(200)
  goldBonusBps   Int @default(500)

  /// Paid conversions needed to reach each tier (see lib/partner/tier.ts).
  silverThreshold Int @default(3)
  goldThreshold   Int @default(10)

  /// Days a commission sits un-payable after capture — the refund window. Was
  /// a hardcoded `REFUND_WINDOW_DAYS = 7` in commissionService.ts; it is here
  /// now because it is the one number a partner asks about ("paisa kab
  /// milega") and the one that has to move if the refund policy moves.
  maturityDays Int @default(7)

  /// Floor for a withdrawal request. A bank transfer has a fixed cost and a
  /// fixed amount of admin attention, so ₹500 of balance is not worth either.
  minWithdrawalPaise Int @default(50000)

  /// Whether the maturity cron flips matured commissions to APPROVED on its
  /// own. On by default: once the refund window has passed there is nothing
  /// left for a human to decide, and leaving hundreds of rows waiting for a
  /// click is how partners end up chasing us. Turn it off to put every rupee
  /// back through the manual queue.
  autoApproveAfterMaturity Boolean @default(true)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("partner_commission_config")
}

/// Outbox and audit trail for every message BandhanTak sends to a lead on a
/// partner's behalf — both the manual "send it for me" button and the
/// automated nudge job.
///
/// This is a stricter privacy boundary than the self-send `wa.me` link it sits
/// beside, not a looser one: there the partner uses their own phone and their
/// own contact list, here the lead's number/email never leaves the server at
/// all. The partner supplies nothing but the decision to send.
///
/// `provider`/`providerRef` stay generic strings so a real WhatsApp Business
/// or email provider can be plugged in (see lib/services/outreach) without a
/// schema change.
/// A person a partner has personally spoken to, who is not on BandhanTak yet.
///
/// ## Why this is not a User row
///
/// The obvious shortcut is to create the account for them and mail them a
/// password link. That is wrong twice over: it fills the member count with
/// people who never agreed to join, and it parks somebody's name and number in
/// `users` with no account they control and no way to remove themselves. So an
/// invite is its own lightweight thing. A real `User` appears only when the
/// person themselves opens the link and registers, at which point
/// `convertedUserId` ties the two together.
///
/// ## consentAttestedAt
///
/// Not decoration. Every other message BandhanTak sends goes to someone who
/// registered and gave us their own number; this one goes to a stranger on a
/// partner's say-so. The partner must tick that they actually spoke to this
/// person first, and that tick is stored with its timestamp — it is the only
/// opt-in record that exists for this contact, and WhatsApp's own policy is
/// the reason it has to exist at all.
model PartnerInvite {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  /// Exactly as the partner typed it — this is not profile data, it is a note
  /// to themselves about who they invited.
  fullName String
  mobile   String?
  email    String?

  /// The whole credential. Opening `/j/<token>` is how the link is redeemed,
  /// so it is random and unguessable — same reasoning as FamilyMember.inviteToken.
  token String @unique

  status  InviteStatus     @default(PENDING)
  /// Null when the partner chose to share the link themselves.
  channel OutreachChannel?

  consentAttestedAt DateTime

  sendProvider  String?
  sendRef       String?
  failureReason String?
  sentAt        DateTime?
  openedAt      DateTime?
  joinedAt      DateTime?

  /// Set once the invited person registers. Unique: one invite, one account.
  convertedUserId String? @unique
  convertedUser   User?   @relation(fields: [convertedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
  @@map("partner_invites")
}

model PartnerOutreachMessage {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel     OutreachChannel
  trigger     OutreachTrigger @default(MANUAL)
  /// Which template produced this. Also the dedupe key for the automated job.
  templateKey String
  /// The lead's status when it was sent — the live status may have moved on.
  leadStatusAtSend String

  subject       String?
  body          String
  status        OutreachStatus @default(QUEUED)
  provider      String?
  providerRef   String?
  failureReason String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  @@index([partnerId, createdAt])
  @@index([userId, templateKey, createdAt])
  @@map("partner_outreach_messages")
}

// PAN/GST/id-document/payout-account are intentionally not collected here.
// M10 itself marks them "placeholder for M14"; storing them with no payout
// flow and no encryption-at-rest would be a liability rather than a feature.
model Partner {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName                 String
  mobileNumber             String
  email                    String?
  city                     String
  state                    String
  partnerType              PartnerType
  organizationName         String?
  experienceYears          Int?
  expectedMonthlyReferrals Int?
  knownCommunityOrArea     String?
  notesFromPartner         String?

  status           PartnerStatus @default(PENDING_APPROVAL)
  rejectionReason  String?
  suspensionReason String?

  /// Whether the nudge job may message this partner's leads on their behalf.
  /// On by default (that is the point of the feature) but a partner who
  /// prefers to do their own follow-up can switch it off without losing the
  /// manual send button.
  autoOutreachEnabled Boolean @default(true)

  /// A rate negotiated for this one partner, in basis points. Null (the normal
  /// case) means the tiered `PartnerCommissionConfig` decides.
  ///
  /// This is the one thing about commission that is *assigned* rather than
  /// earned — the opposite of `PartnerTier` (lib/partner/tier.ts), which is a
  /// pure function of the ledger and deliberately has no admin override. A tier
  /// is a promise to every partner that the same track record pays the same
  /// rate; this is for the handful of deals struck outside that promise (a
  /// bureau bringing volume, a launch-partner agreement) and is why it is a
  /// per-row exception with an audit trail rather than a second rate table.
  ///
  /// The tier is still computed and still recorded on each commission row, so
  /// an override never erases *what the partner would otherwise have earned* —
  /// only what they actually did.
  commissionBpsOverride Int?

  approvedAt    DateTime?
  approvedBy    String?
  rejectedAt    DateTime?
  rejectedBy    String?
  suspendedAt   DateTime?
  suspendedBy   String?
  reactivatedAt DateTime?
  reactivatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referralCodes ReferralCode[]
  referrals     PartnerReferral[]
  commissions   PartnerCommission[]
  outreach      PartnerOutreachMessage[]
  invites       PartnerInvite[]
  payoutAccount PartnerPayoutAccount?
  withdrawals   PartnerWithdrawal[]

  @@index([status])
  @@map("partners")
}

// A partner can hold several rows but only one `active` — a retired code keeps
// resolving so already-printed posters and cards never stop working.
model ReferralCode {
  id        String           @id @default(uuid())
  partnerId String
  partner   Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  code      String           @unique
  type      ReferralCodeType @default(AUTO)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@index([partnerId])
  @@map("referral_codes")
}

/// Attribution happens once at registration and is permanent — hence the
/// unique userId. Only an admin may re-attribute, with a mandatory reason.
model PartnerReferral {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId         String
  partner           Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  codeUsed          String
  attributionMethod AttributionMethod @default(CODE)
  attributedAt      DateTime          @default(now())
  locked            Boolean           @default(true)

  @@index([partnerId])
  @@map("partner_referrals")
}

model ReferralClick {
  id        String   @id @default(uuid())
  code      String
  ipHash    String?
  uaHash    String?
  clickedAt DateTime @default(now())

  @@index([code, clickedAt])
  @@map("referral_clicks")
}

// ============================================================
// D-11's `assistedMatchmaker` — PREMIUM-only, human-only (D-32: AI never
// handles this). Deliberately a plain intake queue, not a CRM: a human still
// does the actual matchmaking outside the app; this only records that someone
// asked and whether staff has responded.
// ============================================================

enum MatchmakerRequestStatus {
  OPEN
  CONTACTED
  RESOLVED
}

model MatchmakerRequest {
  id        String                  @id @default(uuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What the user is looking for, in their own words. Optional — "I want a
  /// call" is a complete request on its own.
  note      String?
  status    MatchmakerRequestStatus @default(OPEN)
  handledBy String?
  handledAt DateTime?
  createdAt DateTime                @default(now())

  @@index([status, createdAt])
  @@map("matchmaker_requests")
}

/// Generic on purpose: M13/M14/M15 write their audit rows here too rather
/// than each inventing a parallel table.
model AdminAuditLog {
  id            String   @id @default(uuid())
  actorId       String
  actorRole     Role
  actionType    String
  targetType    String
  targetId      String
  previousValue String?
  newValue      String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("admin_audit_logs")
}

// D-31 mandatory: every AI call writes a cost/log row.
model AiInteraction {
  id           String    @id @default(uuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      String
  modelId      String
  provider     AiProvider @default(ANTHROPIC)
  inputTokens  Int
  outputTokens Int
  wasBlocked   Boolean   @default(false)
  blockReason  String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([feature])
  @@map("ai_interactions")
}

// Multi-provider AI routing — lets cost be tuned per feature without a
// redeploy. Unlike D-11's plan ladder, there is no "locked" set here: every
// feature key just needs a code-side default (lib/ai/models.ts) for the seed
// and for the one-time bootstrap if a row is ever missing. This table only
// chooses which provider+model a feature calls; the key that authenticates the
// call lives in `ProviderCredential` (or, still, in an env var).
enum AiProvider {
  ANTHROPIC
  OPENAI
  GEMINI
  DEEPSEEK
}

model AiFeatureConfig {
  id        String     @id @default(uuid())
  /** One of lib/ai/models.ts's AI_MODELS keys — e.g. "extraction", "bioWriter". */
  feature   String     @unique
  provider  AiProvider
  modelId   String
  updatedAt DateTime   @updatedAt
  updatedBy String?

  @@map("ai_feature_configs")
}

// ============================================================
// Admin → people messaging (offers, announcements, partner notes)
//
// The gap this fills: there was no way for an admin to say anything to
// anybody. `createNotice()` had ten call sites and every one belonged to a
// feature; the lifecycle engine could *run* pre-written campaigns but an admin
// could never write the words. "Aapko ye offer mila hai" had no path to a
// screen.
//
// Two rules the shape encodes:
//
//   1. **Send is not free.** A recipient count must be computed and shown
//      before anything goes out (dry run), a broadcast to everyone is capped
//      per day, and `AdminMessageDelivery` is uniquely keyed so a double
//      submit cannot message the same person twice.
//   2. **An offer can be real.** `offerGrant` carries an optional entitlement,
//      applied through the existing `grantOverride()` — so "aapko 7 din ke
//      liye Premium mila" actually unlocks Premium instead of being a line of
//      marketing copy the product cannot honour.
// ============================================================

enum AdminMessageAudience {
  USER
  PARTNER
}

enum AdminMessageTarget {
  SINGLE
  SEGMENT
  ALL
}

enum AdminMessageChannel {
  APP
  EMAIL
  WHATSAPP
}

enum AdminMessageStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum AdminMessageDeliveryStatus {
  SENT
  SKIPPED
  FAILED
}

model AdminMessage {
  id       String               @id @default(uuid())
  audience AdminMessageAudience
  target   AdminMessageTarget
  /// Set only when `target` is SINGLE — the User row (a partner is addressed
  /// through their user account, same as everyone else).
  targetUserId String?
  /// Set only when `target` is SEGMENT — a key from lib/services/adminMessage/segments.ts.
  segmentKey   String?

  title    String
  body     String
  href     String?
  channels AdminMessageChannel[]

  /// Optional entitlement handed to every recipient, e.g.
  /// `{"planCode":"PREMIUM","days":7}` or `{"capabilityKey":"boost","value":true,"days":30}`.
  /// Applied via grantOverride() so it flows through the same audit trail and
  /// the same raise-only rule as any hand-issued grant.
  offerGrant Json?

  status         AdminMessageStatus @default(DRAFT)
  recipientCount Int                @default(0)
  sentCount      Int                @default(0)
  failedCount    Int                @default(0)

  createdBy String
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  deliveries AdminMessageDelivery[]

  @@index([createdAt])
  @@map("admin_messages")
}

model AdminMessageDelivery {
  id        String       @id @default(uuid())
  messageId String
  message   AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  channel   AdminMessageChannel

  status        AdminMessageDeliveryStatus
  providerRef   String?
  failureReason String?
  sentAt        DateTime?
  createdAt     DateTime                   @default(now())

  /// The dedupe. A retried or double-clicked send can re-run safely: the
  /// second attempt collides here instead of buzzing someone's phone twice.
  @@unique([messageId, userId, channel])
  @@index([userId])
  @@map("admin_message_deliveries")
}

/// Third-party API keys set from /admin/ai-settings instead of a redeploy.
///
/// Env vars are still honoured and are still the fallback — this table wins
/// when a row exists, so nothing breaks for a deployment that never touches
/// the admin page. What it buys is a key rotation that doesn't need a Railway
/// redeploy, and an admin who can see at a glance which providers are actually
/// configured.
///
/// **The value is encrypted at rest** (AES-256-GCM, see lib/security/
/// secretBox.ts) with a key from `SECRETS_ENCRYPTION_KEY`. A plaintext column
/// would mean a DB dump is a set of live billing credentials, which is a much
/// worse blast radius than the env var it replaced.
///
/// Deliberately NOT here: `RAZORPAY_KEY_SECRET` and the VAPID pair. A payment
/// signing secret should not be rotatable from a web form, and regenerating
/// VAPID keys silently invalidates every existing push subscription.
model ProviderCredential {
  id String @id @default(uuid())
  /// One of lib/ai/credentials.ts's CREDENTIAL_PROVIDERS — e.g. "ANTHROPIC", "SARVAM".
  provider   String   @unique
  cipherText String
  iv         String
  authTag    String
  /// Last 4 characters of the plaintext, so the admin UI can show `••••a1b2`
  /// and a human can confirm *which* key is installed without revealing it.
  lastFour   String
  updatedAt  DateTime @updatedAt
  updatedBy  String?

  @@map("provider_credentials")
}

// Which vendor answers Grio's ears and mouth right now.
//
// Deliberately *not* folded into `AiFeatureConfig`: that table routes
// chat-completions calls and its `AiProvider` enum has no room for Sarvam, who
// sells no text model at all. Speech is a different capability class bought
// from a different set of vendors, so it gets its own one-row table rather than
// a widened enum that would make SARVAM wrongly selectable for every text
// feature.
//
// Split into two columns because the two halves are independently good: Sarvam's
// Bulbul is trained on Indian voices and reads Hinglish without the flat
// American cadence, while Gemini's audio understanding handles code-mixing on
// the way in. An admin should be able to buy the better half of each.
enum VoiceProvider {
  SARVAM
  GEMINI
}

model VoiceSettings {
  /// Always "singleton" — one row, enforced by the default plus @id.
  id          String        @id @default("singleton")
  sttProvider VoiceProvider @default(SARVAM)
  ttsProvider VoiceProvider @default(SARVAM)
  /// Gemini's prebuilt voice name (e.g. "Kore"). Sarvam's speaker is separate
  /// because the two vendors' voice catalogs share no names.
  geminiVoice String        @default("Kore")
  /// Sarvam's Bulbul speaker. Was hard-coded in the TTS route; it lives here now
  /// so both vendors are tunable from the same screen.
  sarvamVoice String        @default("shreya")
  updatedAt   DateTime      @updatedAt
  updatedBy   String?

  @@map("voice_settings")
}

// ============================================================
// M16 — Engagement control plane
// (docs/bandhantak/10_engagement_and_monetization_architecture.md)
//
// Three layers decide what a user may do, in this order:
//
//   1. FeatureFlag        — is this feature switched on at all, and for whom
//   2. PLAN_FEATURES      — D-11's locked ladder (code, not DB — never edited here)
//   3. UserEntitlementOverride + RewardGrant  — per-user additions on top
//
// The ladder itself stays locked in lib/constants/plans.ts. Everything an
// admin can move lives in these tables instead, so "give this user everything
// for a week" never becomes "edit the pricing ladder for everyone".
// ============================================================

/// How wide a feature is currently open. PLAN_GATED is the normal state — the
/// D-11 ladder decides. The other three exist so a feature can be launched,
/// piloted, or killed without a deploy.
enum FeatureRollout {
  OFF /// Kill switch. Nobody, not even an override holder.
  ALLOWLIST /// Only users who hold a matching UserEntitlementOverride.
  PLAN_GATED /// Normal: the plan ladder decides.
  ALL /// Open to everyone regardless of plan — launch/beta mode.
}

model FeatureFlag {
  id        String         @id @default(uuid())
  /// One of lib/constants/features.ts's FEATURE_KEYS.
  key       String         @unique
  rollout   FeatureRollout
  /// Free-text admin note — why it's in this state, so the next person knows.
  note      String?
  updatedAt DateTime       @updatedAt
  updatedBy String?

  @@map("feature_flags")
}

/// A per-user grant an admin makes by hand: either "treat this user as PREMIUM"
/// (planCode set) or "give this user just this one capability" (capabilityKey
/// + value set). Both forms can coexist on one user — the plan override applies
/// first, then capability overrides land on top of it.
///
/// Deliberately additive-only in the service layer: an override can raise what
/// a user may do, never lower it. Taking things away is what SUSPENDED status
/// is for, and mixing the two here would make "why can't this user do X"
/// unanswerable.
model UserEntitlementOverride {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Whole-plan override. Null when this row grants a single capability.
  planCode      String?
  /// A PlanFeatureSet key — "chat", "reelPerDay", "voiceNotesPerDay"…
  /// Null when this row is a plan override.
  capabilityKey String?
  /// JSON-encoded scalar: `true`, `15`, or `null` (= unlimited). Parsed and
  /// type-checked against PlanFeatureSet in entitlementOverrideService.
  value         String?
  /// Mandatory — an override with no stated reason is an unauditable one.
  reason        String
  grantedBy     String
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("user_entitlement_overrides")
}

/// Something the user earned rather than bought — a quest reward, an admin
/// goodwill grant. Sits on top of the plan; never replaces it.
///
/// Economics rule (see §7.6 of the architecture doc): grants may widen what a
/// user can *see* (more reels, more AI asks, one voice unlock, a boost) and
/// must never grant what the plans exist to sell (chat, admirer identity,
/// contact numbers). That rule is enforced in rewardService, not here, because
/// it is a product decision rather than a data-shape one.
enum RewardKind {
  REEL_UNLOCK /// +N cards on today's reel
  AI_ASK /// +N "AI se poocho"
  VOICE_UNLOCK /// right to open one received voice note
  BOOST /// 24h ranking boost
  KUNDLI_UNLOCK /// right to generate one manual-entry kundli without a plan
  MATCH_EXPLAIN /// +N Rishta Lens questions without a Premium plan
}

model RewardGrant {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      RewardKind
  amount    Int
  consumed  Int        @default(0)
  /// questKey, or "admin:<reason>" — where this came from.
  source    String
  /// Quest rewards are always short-lived. A permanent grant is a plan change
  /// wearing a costume.
  expiresAt DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, kind, expiresAt])
  @@map("reward_grants")
}

/// One row per celebration a user has already been shown, ever.
///
/// This table is the whole anti-inflation mechanism: a TIER_FIRST celebration
/// fires only if inserting here succeeds, so "pehli baar" is enforced by a
/// unique constraint rather than by remembering to check. See
/// lib/services/rewards/celebrationService.ts.
model CelebrationLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey String
  firedAt  DateTime @default(now())

  @@unique([userId, eventKey])
  @@map("celebration_logs")
}

// ============================================================
// M16 — Media (audio-first) + Notices
// ============================================================

enum MediaKind {
  VOICE_NOTE
  /// Server-generated blurred copy of a photo. A separate *file*, never a CSS
  /// filter — see §7.4: blur over a static URL is not a privacy boundary.
  PHOTO_BLUR_DERIVATIVE
}

enum MediaModeration {
  PENDING
  APPROVED
  REJECTED
}

/// Every non-public file the app holds.
///
/// Unlike ProfilePhoto (which stores a `fileUrl` under public/uploads and is
/// served statically), a MediaAsset has NO public URL at all. `storageKey` is
/// server-side only and playback goes through GET /api/media/[id], which
/// re-checks permission on every single request. That difference is the point:
/// voice notes are gated content, and a gate you can walk around by reading
/// view-source is not a gate.
model MediaAsset {
  id               String          @id @default(uuid())
  ownerUserId      String
  owner            User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  kind             MediaKind
  /// Private path/key. Never serialised into any API response.
  storageKey       String
  mimeType         String
  durationMs       Int?
  sizeBytes        Int
  /// On-device Web Speech transcript, sent up with the upload. Used for
  /// moderation and as AI context — the server never runs paid STT (D-72 is
  /// still open, and free is the right default until it isn't).
  transcript       String?
  moderation       MediaModeration @default(PENDING)
  moderationReason String?
  createdAt        DateTime        @default(now())
  deletedAt        DateTime?

  voiceNote      VoiceNote?
  pollVoteAnswer PollVote?

  @@index([ownerUserId])
  @@index([moderation])
  @@map("media_assets")
}

enum VoiceNoteContext {
  REEL_INTEREST /// sent from the reel alongside an Interest
  QUESTION_ANSWER /// answer to an Ask-Bridge question
  POLL_ICEBREAKER /// sent to someone who voted the same way
  PARENT_BLESSING /// family member's clip on the owner's own profile (toUserId null)
  MATCH_CHAT /// inside an existing match — needs the chat entitlement
}

/// A 10-second clip aimed at one person.
///
/// This is a richer Interest, not chat. The safety model it must not break
/// (M08): no contact before mutual consent. So it is one-way — the receiver
/// cannot answer without matching — it costs the sender an Interest from their
/// monthly quota, and it is capped at one per candidate per context by the
/// unique index below rather than by a rate limiter someone can forget.
model VoiceNote {
  id           String           @id @default(uuid())
  mediaAssetId String           @unique
  mediaAsset   MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User             @relation("VoiceNoteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  /// Null only for PARENT_BLESSING, which is attached to the sender's own profile.
  toUserId     String?
  toUser       User?            @relation("VoiceNoteTo", fields: [toUserId], references: [id], onDelete: Cascade)
  context      VoiceNoteContext
  /// Set when context is QUESTION_ANSWER.
  relatedQuestionId String?
  /// Null = the receiver still has a locked teaser. Set once they unlock it,
  /// by plan or by spending a VOICE_UNLOCK grant.
  unlockedAt   DateTime?
  playedAt     DateTime?
  createdAt    DateTime         @default(now())

  @@unique([fromUserId, toUserId, context])
  @@index([toUserId, unlockedAt])
  @@map("voice_notes")
}

// ============================================================
// M16 — Quests
// ============================================================

/// Progress against one quest, for one user, in one period.
///
/// The quest *definitions* live in lib/quests/definitions.ts, not here — same
/// reasoning as MINDSET_QUESTIONS and PLAN_FEATURES. A quest is product copy
/// plus a reward rule; putting that in the database would mean a migration
/// every time a sentence changes, and an admin panel that can invent rewards.
///
/// `periodKey` is what makes "daily" work without a scheduler: "2026-08-01"
/// for a daily quest, "once" for a lifetime one. The unique index below is
/// therefore also the idempotency guard — claiming twice cannot double-pay.
model QuestProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questKey    String
  periodKey   String
  progress    Int       @default(0)
  target      Int
  completedAt DateTime?
  rewardedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, questKey, periodKey])
  @@index([userId, completedAt])
  @@map("quest_progress")
}

// ============================================================
// Phase C — Vibe Hub: Mindset Arena polls
// ============================================================

/// Content pool for the "aaj ka poll" card — seeded via prisma/seed.ts, not
/// hardcoded like MINDSET_QUESTIONS, since this bank is meant to grow past
/// launch. `publishedOn` is null while a poll sits in the pool; it's set once
/// (to a "YYYY-MM-DD" key) the first time `getOrCreateTodayPoll()` picks it,
/// and the unique index is the same lazy-daily idempotency guard
/// `DailyReel.reelDate` already uses — nothing has to run at midnight.
/// Which day of the week a poll belongs to. See lib/vibe/pollThemes.ts for the
/// rotation and for why the bank is split this way rather than shuffled.
enum PollTheme {
  PARIVAAR /// Somvaar — joint/nuclear, saas-sasur, rishtedaar
  PAISA /// Mangalvaar — budget, bachat, kiske naam
  CAREER /// Budhwaar — kaam vs ghar, transfer, priority
  RITUALS /// Guruvaar — reeti-riwaj kitne maanne hain
  RED_FLAGS /// Shukravaar — kya cheez rishta tod degi
  SAPNE /// Shanivaar — 5 saal baad kahan
  HALKA /// Ravivaar — khana, film, ghoomna. Low stakes, high participation
}

model Poll {
  id          String     @id @default(uuid())
  /// Stable seed key ("diwali-alternate") — lets prisma/seed.ts upsert
  /// content without duplicating rows on re-run. Never shown to users.
  slug        String     @unique
  /// Defaulted only so the column can be added without a data migration; every
  /// seeded row carries its real theme, set by prisma/seed.ts. A poll that is
  /// still HALKA after a seed run is a poll somebody forgot to categorise.
  theme       PollTheme  @default(HALKA)
  question    String
  /// Fixed tap choices, same "code/content decides, not the user typing
  /// free text" discipline as MINDSET_QUESTIONS.
  options     String[]
  sortOrder   Int        @default(0)
  publishedOn String?    @unique

  /// Pulled out of the rotation without being deleted. A poll that has been
  /// voted on can never be deleted — its votes are public on people's Soch
  /// Boards and feed `sochFit` matching — so "we don't want to ask this any
  /// more" needs its own state rather than a DELETE somebody will reach for.
  retiredAt   DateTime?

  votes       PollVote[]

  @@index([sortOrder])
  /// The rotation's one hot path: "next unshown, unretired poll in today's theme".
  @@index([theme, retiredAt, publishedOn, sortOrder])
  @@map("polls")
}

/// One vote, locked in on first cast — `castVote`'s upsert makes a repeat
/// tap a harmless no-op rather than letting someone change their answer
/// after seeing the running results (C7's Soch Board makes these public,
/// so "what did you actually think" has to stay honest).
model PollVote {
  id          String   @id @default(uuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIndex Int
  votedAt     DateTime @default(now())

  /// C7 — an optional "why I picked this" clip. Deliberately its own direct
  /// link rather than a VoiceNote row: a Soch Board clip has no recipient and
  /// costs no Interest, so `VoiceNote`'s (fromUserId, toUserId, context)
  /// shape and its `sendInterest` side effect simply don't apply here — one
  /// PollVote, at most one clip, is the whole relationship.
  voiceNoteMediaId String?     @unique
  voiceNoteMedia   MediaAsset? @relation(fields: [voiceNoteMediaId], references: [id], onDelete: SetNull)

  @@unique([pollId, userId])
  @@index([userId])
  @@map("poll_votes")
}

// ============================================================
// Phase D — Ask Bridge
// ============================================================

enum ProfileQuestionStatus {
  PENDING /// asked, moderation cleared, awaiting the recipient's voice answer
  ANSWERED
  DECLINED
  EXPIRED
}

/// P7 — "ask AI to ask": one typed question, aimed at one candidate, answered
/// only in voice. The asker already knows exactly who they picked; the
/// *recipient* does not know who asked until they answer — that curiosity gap
/// is the whole growth mechanic, so masking lives on the Notice this creates,
/// symmetric with VoiceNote's masked teaser.
///
/// Two different PENDING states share this row on purpose, same split as
/// MediaAsset/VoiceNote: `moderation` is the safety gate on the *text* content
/// (never shown to anyone until APPROVED); `status` is the conversation's own
/// state once that gate has cleared. A row that never clears moderation simply
/// never reaches PENDING-conversation in the recipient's eyes — no Notice was
/// ever sent for it.
model ProfileQuestion {
  id           String @id @default(uuid())
  fromUserId   String
  fromUser     User   @relation("ProfileQuestionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User   @relation("ProfileQuestionTo", fields: [toUserId], references: [id], onDelete: Cascade)
  /// What the user actually typed.
  questionText String
  /// AI-softened rewording (Haiku) — shown instead of questionText when present.
  /// Best-effort: a failed rewrite still delivers the original, safety-checked text.
  politeText       String?
  moderation       MediaModeration       @default(PENDING)
  moderationReason String?
  status           ProfileQuestionStatus @default(PENDING)
  /// Set once the recipient answers. Denormalised pointer (mirrors
  /// VoiceNote.relatedQuestionId on the other side) rather than a Prisma
  /// relation — the two rows are written in one flow, never queried starting
  /// from this field, so a plain id is enough.
  answerVoiceNoteId String?
  answeredAt        DateTime?
  /// Jawab dene ke baad hi asker ki identity khulti hai — set the moment the
  /// recipient answers, independent of whether their clip itself has cleared
  /// moderation yet. Revealing a name carries none of the audio-content risk
  /// the moderation gate exists for.
  askerRevealedAt DateTime?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([moderation])
  @@map("profile_questions")
}

// ============================================================
// Phase E — 2-player Quiz Battle
// ============================================================

enum QuizBattleStatus {
  PENDING /// one side proposed, waiting for the other to accept
  ACTIVE /// accepted — both may answer
  COMPLETED /// both have answered every question
  DECLINED
}

/// P6's 2-player variant — match-gated (chat already exists, so this is a
/// lighter-stakes fun addition to an already-consented conversation, not a
/// new contact channel the way Ask Bridge or voice notes are).
model QuizBattle {
  id           String           @id @default(uuid())
  matchId      String
  match        Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  initiatorId  String
  status       QuizBattleStatus @default(PENDING)
  /// Picked once at creation from lib/quiz/battleQuestions.ts's code-defined
  /// bank — content is code, same as MINDSET_QUESTIONS/QUESTS, so a battle's
  /// question set never changes under the players once it has started.
  questionKeys String[]
  createdAt    DateTime         @default(now())
  completedAt  DateTime?

  answers QuizBattleAnswer[]

  @@index([matchId, status])
  @@map("quiz_battles")
}

/// One row per (battle, player, question). Neither player's answers are
/// shown to the other until `QuizBattle.status = COMPLETED` — see
/// quizBattleService's read path — so answering first is never a disadvantage.
model QuizBattleAnswer {
  id          String     @id @default(uuid())
  battleId    String
  battle      QuizBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId      String
  questionKey String
  optionIndex Int
  answeredAt  DateTime   @default(now())

  @@unique([battleId, userId, questionKey])
  @@map("quiz_battle_answers")
}

// ============================================================
// M16 — Safety: block & report
//
// Shipped in the same phase as voice notes, deliberately. A one-way channel to
// a stranger without a way to stop it is not a feature, it is a liability —
// and "we'll add reporting later" is how every platform learns that lesson the
// expensive way.
// ============================================================

/// One-way and absolute: the blocker stops seeing the blocked in their reel,
/// and the blocked can no longer send them anything. Not symmetric in intent
/// (the blocked person is never told), but symmetric in effect on discovery —
/// `getCandidates` filters both directions, because a blocked person still
/// showing up in the blocker's reel would be the whole point missed.
model UserBlock {
  id            String   @id @default(uuid())
  blockerUserId String
  blocker       User     @relation("BlockFrom", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUserId String
  blocked       User     @relation("BlockTo", fields: [blockedUserId], references: [id], onDelete: Cascade)
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

enum ReportTargetType {
  VOICE_NOTE
  PROFILE
  MESSAGE
  QUESTION
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

model ContentReport {
  id             String           @id @default(uuid())
  reporterUserId String
  reporter       User             @relation("ReportFrom", fields: [reporterUserId], references: [id], onDelete: Cascade)
  /// Denormalised from the target so the admin queue can group by person
  /// without resolving three different target types on every row.
  reportedUserId String
  reported       User             @relation("ReportTo", fields: [reportedUserId], references: [id], onDelete: Cascade)
  targetType     ReportTargetType
  targetId       String
  reason         String
  details        String?
  status         ReportStatus     @default(OPEN)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@map("content_reports")
}

enum NoticeKind {
  VOICE_NOTE_RECEIVED
  QUESTION_ASKED
  QUESTION_ANSWERED
  QUEST_AVAILABLE
  REWARD_EARNED
  FAMILY_ACTION
  MATCH_CREATED
  CHAT_NUDGE
  MATCHMAKER_UPDATE
  /// An admin handed this user a plan or a capability by hand
  /// (UserEntitlementOverride). Without a notice the grant was completely
  /// silent — the user's own subscription card said "Free" until they happened
  /// to reload, and nothing ever told them why it changed.
  PLAN_GRANTED
  /// Admin-authored message or offer (see AdminMessage). The only NoticeKind
  /// whose text a human wrote at send time rather than a feature generating
  /// it, which is why it gets first place in the dashboard banner.
  ANNOUNCEMENT
}

/// The app's one inbox. Before this, three separate features each needed a way
/// to tell a user something happened and none had one.
model Notice {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        NoticeKind
  title       String
  body        String
  href        String?
  /// True while the actor's identity is deliberately withheld — a locked voice
  /// note or an unanswered question. The *title/body* must already be written
  /// without identifying detail; this flag is for the UI's lock affordance, not
  /// the redaction itself.
  actorMasked Boolean    @default(false)
  relatedId   String?
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notices")
}

// ============================================================
// Phase F — Serious Circle
//
// The app's one *intent-segmented* surface. Every other feature treats all
// users as one pool; this one splits them into "shaadi ab karni hai" and
// everyone else — because that is the split users actually care about and the
// one no algorithm can infer from a profile.
//
// ## Why an event, and not a filter
//
// A "serious" checkbox is worth nothing: everyone ticks it. What cannot be
// faked is *turning up*. A fixed two-hour window twice a week, with
// registration closing 24h before, makes attendance itself the filter — a
// timepass user does not show up at 8pm every Wednesday and Sunday for weeks.
// That is the entire design premise, and it is why `startsAt`/`endsAt` are
// real columns rather than a soft "active" boolean.
//
// ## Why there is no cron
//
// Nothing in this app runs on a scheduler (see `DailyReel.reelDate` and
// `Poll.publishedOn` for the same call). Status transitions are computed
// lazily on read and written through when they first become true, so a
// deployment with zero background workers still behaves correctly. The unique
// constraints below are what make that idempotent under concurrent reads.
// ============================================================

enum CircleEventStatus {
  /// Announced; registration open.
  SCHEDULED
  /// Registration closed (startsAt - 24h). Roster frozen, ratio balanced,
  /// pairings computed. Nobody may join after this — that is the commitment.
  LOCKED
  /// Inside the [startsAt, endsAt] window. The only state where pairings are
  /// visible and Connect is tappable.
  LIVE
  COMPLETED
  /// Did not reach `minParticipants` by lock time. Cancelling loudly is much
  /// better than running an event with nine people in it.
  CANCELLED
}

enum CircleEntryStatus {
  /// Signed up, all gates passed at the time of signup.
  REGISTERED
  /// Pushed out by gender-ratio balancing at lock time. Not a rejection —
  /// first in line for the next event.
  WAITLISTED
  /// On the locked roster.
  CONFIRMED
  /// Opened the room inside the live window. The only status that earns a badge.
  ATTENDED
  /// Confirmed but never showed. Costs nothing directly, but no badge.
  NO_SHOW
  WITHDRAWN
}

/// Declared, not inferred. Snapshotted onto each `CircleEntry` so a user who
/// quietly relaxes their timeline later doesn't rewrite the history of an
/// event they already attended.
enum MarriageTimeline {
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  WITHIN_1_YEAR
}

model CircleEvent {
  id   String @id @default(uuid())
  /// "2026-08-09-sun" — the slot key. Unique, so the lazy provisioner can
  /// upsert the next event from any request without two concurrent readers
  /// creating it twice. Same guard as `Poll.publishedOn`.
  slug String @unique

  startsAt DateTime
  endsAt   DateTime
  /// Always `startsAt - 24h`. Stored rather than derived so a one-off event
  /// with a longer runway is representable without a code change.
  registrationClosesAt DateTime

  status CircleEventStatus @default(SCHEDULED)

  /// Below this on the confirmed roster, the event cancels itself at lock
  /// time. The empty-room failure is the one that kills this feature, so it
  /// is a column an admin can raise per event, not a constant.
  minParticipants Int @default(20)

  lockedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  entries     CircleEntry[]
  connections CircleConnection[]

  @@index([status, startsAt])
  @@map("circle_events")
}

model CircleEntry {
  id      String      @id @default(uuid())
  eventId String
  event   CircleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  status CircleEntryStatus @default(REGISTERED)

  /// Snapshots taken at registration. `gender` is duplicated from Profile so
  /// ratio balancing at lock time is one query over this table instead of a
  /// join across every participant's profile — and so the roster stays
  /// auditable even if someone edits their profile afterwards.
  timeline MarriageTimeline
  gender   String

  registeredAt DateTime  @default(now())
  attendedAt   DateTime?

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("circle_entries")
}

/// One AI-proposed pair inside one event, plus each side's answer.
///
/// Deliberately *not* an `Interest` row. An Interest is one person choosing to
/// reach out and it spends their monthly quota; a Circle pairing is the app
/// putting two people in front of each other simultaneously, where neither
/// initiated and neither should be charged. Both sides accepting is what
/// creates the real `Match` — the same mutual-consent rule as everywhere else,
/// just reached in one step instead of two.
model CircleConnection {
  id      String      @id @default(uuid())
  eventId String
  event   CircleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Ordered so the lexicographically smaller user id is always A — makes the
  /// unique constraint below actually prevent duplicate pairs rather than
  /// storing each pair twice in opposite order.
  userAId String
  userA   User   @relation("CircleConnA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String
  userB   User   @relation("CircleConnB", fields: [userBId], references: [id], onDelete: Cascade)

  score Int
  /// 1 = the event's best-scoring pair. Drives the "sabse achhi jodi" prize.
  rank  Int

  /// Human-checkable "why", built from counts at lock time — e.g. "7 me se 5
  /// sawaalon par ek jaisa jawab". Null when the pair's only signal was the
  /// AI-inferred dimensions, because "our model thinks you're similar" is not
  /// something a user can verify (D-32). Stored rather than recomputed: it is
  /// a fact about the moment the pairing was made, and the underlying votes
  /// keep accumulating afterwards.
  sochReason String?

  aAnsweredAt DateTime?
  aAccepted   Boolean?
  bAnsweredAt DateTime?
  bAccepted   Boolean?

  /// Set only when both sides accepted.
  connectedAt DateTime?
  /// `connectedAt + 48h` (7 days for rank 1). While this is in the future,
  /// this pair may chat regardless of plan — see
  /// lib/services/circle/chatWindow.ts for why that is a bounded conversion
  /// lever and not a hole in the plan ladder.
  windowEndsAt DateTime?

  /// The real Match row, created on mutual accept. Null until then.
  matchId String? @unique

  /// Set once the ghosting sweep has judged this connection. An explicit
  /// marker rather than a date-range heuristic: the sweep runs lazily on page
  /// loads, so "have we already penalised this one" must be a fact in the row
  /// and not something inferred from how long ago the window closed.
  ghostSweptAt DateTime?

  createdAt DateTime @default(now())

  @@unique([eventId, userAId, userBId])
  @@index([eventId, rank])
  @@index([userAId])
  @@index([userBId])
  @@map("circle_connections")
}

/// "Shaadi Ready" — the badge the whole feature exists to produce.
///
/// One row per user, rewritten on each attended event rather than appended to:
/// what matters is whether this person is serious *now*, and a history table
/// would invite showing "attended 9 events", which reads as unsuccessful
/// rather than committed.
///
/// `expiresAt` is not optional by accident. A permanent badge becomes a lie
/// within a month of someone getting engaged elsewhere, and a badge that can
/// lie is worse than no badge.
model SeriousBadge {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  earnedAt  DateTime @default(now())
  expiresAt DateTime

  /// Ghosting penalty. Set when this user accepted a Circle connection and
  /// then said nothing for 48h — the badge goes dark for two weeks. Without
  /// this the Circle degrades into the normal app within a month, because the
  /// cost of showing up and then ignoring people would be zero.
  suspendedUntil DateTime?
  suspendReason  String?

  eventsAttended Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
  @@map("serious_badges")
}
