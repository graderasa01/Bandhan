{
  "expo": {
    "name": "BandhanTak",
    "slug": "bandhantak",
    "scheme": "bandhantak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#2a0710",
    "primaryColor": "#8c2233",
    "description": "BandhanTak — rishta dhoondhne ka bharosemand tareeqa. Members ke liye official app.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bandhantak.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bandhantak.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#4a1119"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#2a0710"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "BandhanTak aapki awaaz se profile bharne aur voice message ke liye microphone use karta hai."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BandhanTak aapki chuni hui photo profile par lagane ke liye gallery kholta hai.",
          "cameraPermission": "BandhanTak profile photo lene ke liye camera use karta hai."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8c2233"
        }
      ],
      "expo-web-browser",
      "expo-localization",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "003ce9fb-6a86-46a3-9613-2426f32ca11e"
      }
    },
    "owner": "bandhatantak-expo"
  }
}
