# Copy to `.env` (never commit real values — this app ships NO secrets; every
# AI / SMS / payment key stays on the BandhanTak server).

# Where the BandhanTak backend lives.
#   Production:        https://bandhantak.com
#   Phone on your LAN: http://<your-PC-LAN-IP>:3000   (next dev listens on all interfaces)
#   Android emulator:  http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=https://bandhantak.com

# live = real API.  mock = built-in sample data (no backend needed — UI work, demos).
EXPO_PUBLIC_DATA_MODE=mock

# Web preview only: call /api same-origin through metro.config.js's proxy.
# `npm run web:live` sets this (and BANDHANTAK_API_PROXY) for you.
# EXPO_PUBLIC_WEB_API_PROXY=1
