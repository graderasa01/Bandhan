node_modules
.next/
# PID/session lock for the current Claude Code run — rewritten every
# process start, so tracking it is pure diff noise, never real project state.
.claude/scheduled_tasks.lock
.env*.local
.env
*.tsbuildinfo
_archive/
# Deeply nested planning docs hit Windows' 260-char path limit during `git
# add` (long-paths isn't enabled at the git/OS level here). Not needed for
# the deployed app itself — revisit if this repo grows beyond a Railway
# upload target and docs need to be versioned too.
docs/
Bnadhantak.com-main/

# Runtime user uploads — never source. private-media/ holds gated audio and is
# served only through /api/media/[id]; public/uploads/ holds profile photos.
private-media/
public/uploads/
# Partner identity documents. Same rule as private-media/ and then some: these
# bytes have no public URL at all and leave only through the audited admin
# route. A copy in git history would outlive every deletion path we have.
private-kyc/

# Google Drive's partial-upload chunks and Chrome's network log both land in
# the project root when the folder is synced or the browser is driven from
# here. Neither is project state.
.tmp.driveupload/
debug.log
